<%- include("../layouts/boilerplate.ejs") -%>
<link rel="stylesheet" href="/css/files.css">

<div class="container mt-4" id="fileContainer" data-folder-id="<%= folder.id %>">
  <h3><%= folder.name %></h3>

  <!-- Styled AJAX Search Bar -->
  <form class="input-group mb-4 mt-3" onsubmit="return false;">
    <input type="text" id="fileSearch" class="form-control" placeholder="Search files...">
    <button class="btn btn-warning" type="button">
      <img width="28" height="28" src="https://img.icons8.com/pastel-glyph/64/FFFFFF/search--v1.png" alt="search--v1"/>
      <i class="bi bi-search"></i>
    </button>
  </form>
  <p id="fileEmpty" class="text-muted mt-2" style="display:none;">No files found.</p>

  <!-- Upload File -->
  <div class="card mt-4 shadow-sm border-0">
    <div class="card-body">
      <h5 class="card-title mb-3">Upload a File</h5>
      <form method="POST" action="/upload-file" enctype="multipart/form-data" id="uploadForm">
        <input type="hidden" name="folderId" value="<%= folder.id %>">

        <div class="mb-3">
          <label for="fileInput" class="form-label">Choose a file (PDF or JPG)</label>
          <input type="file" class="form-control" id="fileInput" name="file" accept=".pdf,.jpg,.jpeg" required>
          <div class="form-text text-muted">Maximum file size allowed: <strong>2MB</strong></div>
          <div class="invalid-feedback text-danger mt-2" id="fileError" hidden>
            File size exceeds 2MB. Please choose a smaller file.
          </div>
        </div>

        <button type="submit" class="btn btn-success">
          <i class="bi bi-cloud-upload me-1"></i> Upload
        </button>
      </form>
    </div>
  </div>

  <!-- File List -->
  <ul class="list-group mt-4" id="fileList">
    <% files.forEach(file => { %>
      <li class="list-group-item file-item d-flex justify-content-between align-items-center mb-2" data-id="<%= file.id %>">
        <span><%= file.filename %></span>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#fileModal" data-id="<%= file.id %>" title="File Preview">
            <img width="20" height="20" src="https://img.icons8.com/ios-filled/50/FFFFFF/file-preview.png" alt="file-preview"/>
          </button>
          <a href="/download-file/<%= file.id %>" class="btn px-2 btn-sm btn-success" title="Download File">
            <img width="22" height="22" src="https://img.icons8.com/material-sharp/24/FFFFFF/download--v1.png" alt="download--v1"/>
          </a>
          <button class="btn btn-sm btn-danger px-2.5" title="Delete File"
                  data-bs-toggle="modal"
                  data-bs-target="#deleteFileModal"
                  data-id="<%= file.id %>"
                  data-name="<%= file.filename %>">
            <img width="22" height="22" src="https://img.icons8.com/material-rounded/24/FFFFFF/filled-trash.png" alt="filled-trash"/>
            <i class="bi bi-trash"></i>
          </button>
        </div>
      </li>
    <% }) %>
  </ul>
</div>

<!-- File Preview Modal -->
<div class="modal fade" id="fileModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">File Preview</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0 text-center">
        <div id="fileViewerWrapper"></div>
      </div>
    </div>
  </div>
</div>

<!-- Delete File Modal -->
<div class="modal fade" id="deleteFileModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form method="POST" id="deleteFileForm">
        <input type="hidden" name="folderId" value="<%= folder.id %>">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Delete</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>Delete file <strong id="fileName"></strong>?</p>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-danger">Delete</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/files.js"></script>