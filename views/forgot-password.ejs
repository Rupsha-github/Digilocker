<%- include("../layouts/boilerplate") -%>

<% if (errorMessage && errorMessage.length > 0) { %>
  <div class="alert alert-danger text-center mt-3 mx-auto" style="max-width: 600px;">
    <%= errorMessage %>
  </div>
<% } %>

<div class="container mt-5">
  <h3>Forgot Password</h3>
  <form method="POST" action="/auth/forgot-password" class="needs-validation" novalidate>
    <div class="mb-3">
      <label for="email" class="form-label">Registered Email</label>
      <input type="email" name="email" id="email" class="form-control" required>
      <div class="invalid-feedback">Please enter your registered email.</div>
    </div>
    <button class="btn btn-primary">Send OTP</button>
  </form>
</div>

<script src="/js/timeout.js"></script>