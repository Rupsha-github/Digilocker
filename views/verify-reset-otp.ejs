<head>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/verify-reset-otp.css">
</head>

<h2 class="text-center">Verify OTP to Reset Password</h2>

<% if (error) { %>
  <div class="alert alert-danger text-center"><%= error %></div>
<% } %>

<div class="text-center mb-3">
  <strong>Time left: <span id="timer">10:00</span></strong>
</div>

<form method="POST" action="/auth/verify-reset-otp" class="col-6 offset-3">
  <div id="otp-container" class="d-flex justify-content-center gap-2">
    <% for (let i = 0; i < 6; i++) { %>
      <input type="text" maxlength="1" class="otp-input form-control text-center" name="otpBox" required>
    <% } %>
  </div>
  <input type="hidden" name="otp" id="otp-hidden">
  <button class="btn btn-primary mt-3 d-block mx-auto">Verify</button>
</form>

<script src="/js/verify-reset-otp.js"></script>
<script src="/js/timeout.js"></script>