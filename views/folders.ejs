<%- include("../layouts/boilerplate.ejs") -%>
<link rel="stylesheet" href="/css/folders.css">

<div class="container mt-4">
  <h2>Your Digilocker Folders</h2>

  <!-- Styled AJAX Search Bar -->
  <form class="input-group mb-4 mt-3" onsubmit="return false;">
    <input type="text" id="folderSearch" class="form-control" placeholder="Search folders...">
    <button class="btn btn-warning" type="button">
      <img width="28" height="28" src="https://img.icons8.com/pastel-glyph/64/FFFFFF/search--v1.png" alt="search--v1"/>
      <i class="bi bi-search"></i>
    </button>
  </form>
  <p id="folderEmpty" class="text-muted mt-2" style="display:none;">No folders found.</p>

  <!-- Create Folder -->
  <form method="POST" action="/create-folder" class="d-flex gap-2 mt-3">
    <input name="folderName" class="form-control" placeholder="New folder name" required>
    <button class="btn btn-outline-primary fs-6 px-0">
      <i class="bi bi-plus-lg me-1"></i> Create New Folder
    </button>
  </form>

  <!-- Folder List -->
  <ul class="list-group mt-4" id="folderList">
  <% folders.forEach(folder => { %>
    <li class="list-group-item folder-item d-flex justify-content-between align-items-center mb-2" data-id="<%= folder.id %>">
      <span><%= folder.name %></span>
      <div class="d-flex gap-2">
        <!-- Open button: visible only on small screens -->
        <button class="btn btn-sm btn-outline-success d-md-none open-folder-btn" data-id="<%= folder.id %>" title="Open folder">
          <img width="22" height="22" src="https://img.icons8.com/ios-filled/50/228BE6/opened-folder.png" alt="opened-folder"/>
          <i class="bi bi-folder2-open"></i>
        </button>

        <!-- Delete button -->
        <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteFolderModal" data-id="<%= folder.id %>" data-name="<%= folder.name %>" title="Delete folder">
          <img width="22" height="22" src="https://img.icons8.com/material-rounded/24/FFFFFF/filled-trash.png" alt="filled-trash"/>
          <i class="bi bi-trash"></i>
        </button>
      </div>
    </li>
  <% }) %>
  </ul>
</div>

<!-- Delete Folder Modal -->
<div class="modal fade" id="deleteFolderModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form method="POST" id="deleteFolderForm">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Delete</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>Delete folder <strong id="folderName"></strong>?</p>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-danger">Delete</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/folders.js"></script>
