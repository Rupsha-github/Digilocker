<%- include("../layouts/boilerplate.ejs") -%>

<% if (successMessage && successMessage.length > 0) { %>
  <div class="alert alert-success text-center mt-3 mx-auto" style="max-width: 600px;">
    <%= successMessage %>
  </div>
<% } %>

<% if (errorMessage && errorMessage.length > 0) { %>
  <div class="alert alert-danger text-center mt-3 mx-auto" style="max-width: 600px;">
    <%= errorMessage %>
  </div>
<% } %>

<div class="row mt-4">
    <h1 class="col-6 offset-3">Login to Digilocker</h1>
    <div class="col-6 offset-3">
        <form method="POST" action="/auth/login" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" type="email" value="<%= formData.email || '' %>" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" id="password" type="password" class="form-control" required>
            </div>
            <button class="btn btn-success col-4 offset-4">Login</button>
            <div class="text-center mt-3">
              <a href="/auth/forgot-password" class="text-decoration-none">Forgot Password?</a>
            </div>
        </form>
    </div>
</div>
<script src="/js/timeout.js"></script>