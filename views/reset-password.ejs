<%- include("../layouts/boilerplate") -%>

<% if (successMessage && successMessage.length > 0) { %>
  <div class="alert alert-success text-center mt-3 mx-auto" style="max-width: 600px;">
    <%= successMessage %>
  </div>
<% } %>

<% if (errorMessage && errorMessage.length > 0) { %>
  <div class="alert alert-danger text-center mt-3 mx-auto" style="max-width: 600px;">
    <%= errorMessage %>
  </div>
<% } %>

<div class="container mt-5">
  <h3>Reset Your Password</h3>
  <form method="POST" action="/auth/reset-password" class="needs-validation" novalidate>
    <input type="hidden" name="email" value="<%= email %>">

    <div class="mb-3">
      <label for="newPassword" class="form-label">New Password</label>
      <input type="password" name="newPassword" id="newPassword" class="form-control" required>
      <div class="invalid-feedback">Please enter a new password.</div>
    </div>

    <button class="btn btn-warning">Reset Password</button>
  </form>
</div>

<script src="/js/timeout.js"></script>
<script>
  if (sessionStorage.getItem('resetOtpTimer')) {
    sessionStorage.removeItem('resetOtpTimer');
  }
</script>
